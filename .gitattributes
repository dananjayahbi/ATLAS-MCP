* text=auto

# Windows launchers must be CRLF on every checkout. cmd.exe mis-parses labels,
# `goto`, and multi-line blocks in LF-only .bat files.
*.bat text eol=crlf
*.cmd text eol=crlf

# Byte-exact artifacts: never touch these.
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
*.db binary
*.sqlite3 binary
